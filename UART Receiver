module uart_rx #(
    parameter CLK_FREQ = 100,
    parameter BAUD_RATE = 10
)(
    input  wire       clk,
    input  wire       reset,

    input  wire       rx,

    output reg [7:0]  rx_data,
    output reg        rx_valid
);

    localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

    reg [31:0] clk_count;
    reg [3:0]  bit_count;
    reg [7:0]  rx_shift;
    reg        receiving;

    always @(posedge clk or posedge reset) begin

        if (reset) begin
            clk_count <= 32'd0;
            bit_count <= 4'd0;
            rx_shift  <= 8'd0;
            rx_data   <= 8'd0;
            rx_valid  <= 1'b0;
            receiving <= 1'b0;
        end

        else begin

            rx_valid <= 1'b0;

            if (!receiving) begin

                // Detect start bit
                if (rx == 1'b0) begin
                    receiving <= 1'b1;

                    // Wait half a bit period
                    clk_count <= CLKS_PER_BIT / 2;
                    bit_count <= 4'd0;
                end

            end

            else begin

                if (clk_count == CLKS_PER_BIT - 1) begin

                    clk_count <= 32'd0;

                    if (bit_count < 8) begin

                        // Receive data bits
                        rx_shift[bit_count] <= rx;
                        bit_count <= bit_count + 1'b1;

                    end

                    else begin

                        // Stop bit
                        receiving <= 1'b0;

                        rx_data  <= rx_shift;
                        rx_valid <= 1'b1;
                    end

                end

                else begin
                    clk_count <= clk_count + 1'b1;
                end

            end

        end

    end

endmodule
