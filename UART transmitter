module uart_tx #(
    parameter CLK_FREQ = 100,
    parameter BAUD_RATE = 10
)(
    input  wire       clk,
    input  wire       reset,

    input  wire       tx_start,
    input  wire [7:0] tx_data,

    output reg        tx,
    output reg        tx_busy
);

    localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

    reg [31:0] clk_count;
    reg [3:0]  bit_count;
    reg [9:0]  tx_shift;

    always @(posedge clk or posedge reset) begin

        if (reset) begin
            tx        <= 1'b1;
            tx_busy   <= 1'b0;
            clk_count <= 32'd0;
            bit_count <= 4'd0;
            tx_shift  <= 10'b1111111111;
        end

        else begin

            if (!tx_busy) begin

                tx <= 1'b1;

                if (tx_start) begin
                    // Frame:
                    // Stop + Data + Start
                    tx_shift  <= {1'b1, tx_data, 1'b0};
                    tx_busy   <= 1'b1;
                    clk_count <= 32'd0;
                    bit_count <= 4'd0;

                    // Start bit
                    tx <= 1'b0;
                end

            end

            else begin

                if (clk_count == CLKS_PER_BIT - 1) begin

                    clk_count <= 32'd0;

                    if (bit_count == 4'd9) begin
                        // Transmission complete
                        tx_busy   <= 1'b0;
                        tx        <= 1'b1;
                        bit_count <= 4'd0;
                    end

                    else begin
                        bit_count <= bit_count + 1'b1;

                        // Shift to next bit
                        tx_shift <= {1'b1, tx_shift[9:1]};
                        tx <= tx_shift[1];
                    end

                end

                else begin
                    clk_count <= clk_count + 1'b1;
                end

            end

        end

    end

endmodule
